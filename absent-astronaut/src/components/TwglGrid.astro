---
// TwiglGrid.astro
---

<canvas id="twigl-canvas" class="fixed inset-0 -z-10 w-full h-full bg-slate-950"
></canvas>

<script>
  import { createWebGL2Context, khronos } from "twgl";

  const canvas = document.getElementById("twigl-canvas") as HTMLCanvasElement;
  const gl = createWebGL2Context({ canvas });

  if (!gl) {
    console.error("WebGL2 not supported");
  } else {
    // 1. Grid Configuration & Constants
    const COLS = 10;
    const ROWS = 5;
    const MAX_BALLS = COLS * ROWS;
    const DROP_INTERVAL = 5000; // 5 seconds
    const FALL_SPEED = 0.4; // Grid units per second

    // Track how many balls are currently stacked in each column
    const columnHeights = new Array(COLS).fill(0);

    // Ball structure for JavaScript state tracking
    interface Ball {
      col: number;
      targetRow: number;
      currentRow: number;
      isFalling: boolean;
    }

    const balls: Ball[] = [];

    // 2. Uniform Arrays for the Shader
    // We pass flat arrays to WebGL: 2 floats per ball for position (x, y)
    const ballPositions = new Float32Array(MAX_BALLS * 2).fill(-99.0);

    // 3. Setup Twigl Program
    const program = khronos(
      gl,
      `
      #version 300 es
      precision highp float;

      out vec4 fragColor;

      uniform vec2 resolution;
      uniform int numBalls;
      uniform vec2 ballPositions[50]; // COLS * ROWS max capacity

      // Signed Distance Field for a circle
      float sdCircle(vec2 p, float r) {
        return length(p) - r;
      }

      void main() {
        // Normalize coordinates to a square system tracking aspect ratio
        vec2 uv = gl_FragCoord.xy / resolution.xy;
        float aspect = resolution.x / resolution.y;
        vec2 p = uv;
        p.x *= aspect;

        // Map the 10x5 grid into the normalized UV space
        // We leave a bit of padding around the edges
        vec2 gridScale = vec2(10.0, 5.0);
        vec2 normP = p * 12.0 - vec2(1.0, 1.0); 

        // Background color
        vec3 color = vec3(0.05, 0.05, 0.1); 

        // Draw the static background grid slots (Connect 4 style cutouts)
        for(int c = 0; c < 10; c++) {
          for(int r = 0; r < 5; r++) {
            vec2 slotPos = vec2(float(c) + 0.5, float(r) + 0.5);
            float slotDist = sdCircle(normP - slotPos, 0.4);
            // Faint grid rings
            color = mix(color, vec3(0.15, 0.15, 0.25), smoothstep(0.02, 0.0, abs(slotDist) - 0.01));
          }
        }

        // Render the active balls using the positions array passed from JS
        for(int i = 0; i < numBalls; i++) {
          vec2 ballPos = ballPositions[i];
          // Simple offset adjustment to center the ball in its grid square coordinate
          vec2 centerPos = ballPos + vec2(0.5, 0.5);
          
          float d = sdCircle(normP - centerPos, 0.4);
          
          // Smooth edge antialiasing for the falling circles
          if (d < 0.0) {
            vec3 ballColor = vec3(0.9, 0.2, 0.4); // Vibrant coral/red
            color = mix(color, ballColor, smoothstep(0.02, 0.0, d));
          }
        }

        fragColor = vec4(color, 1.0);
      }
    `,
    );

    // 4. Game & Animation Loop Logic
    function dropBall() {
      // Find columns that aren't full yet
      const availableCols = [];
      for (let c = 0; c < COLS; c++) {
        if (columnHeights[c] < ROWS) {
          availableCols.push(c);
        }
      }

      if (availableCols.length === 0) return; // Grid is full

      // Pick a random available column
      const randomCol =
        availableCols[Math.floor(Math.random() * availableCols.length)];
      const targetRow = columnHeights[randomCol];

      // Increment the stack height for that column immediately so the next ball stacks on top
      columnHeights[randomCol]++;

      // Spawn ball at the top (Row index 5 sits just above the visible 0-4 grid)
      balls.push({
        col: randomCol,
        targetRow: targetRow,
        currentRow: 5.0,
        isFalling: true,
      });
    }

    // Spawn the first ball and set up the 5-second cadence
    dropBall();
    setInterval(dropBall, DROP_INTERVAL);

    let lastTime = 0;

    function render(now: number) {
      // Calculate delta time in seconds
      const delta = (now - lastTime) * 0.001;
      lastTime = now;

      // Update falling mechanics
      for (let i = 0; i < balls.length; i++) {
        const ball = balls[i];
        if (ball.isFalling) {
          ball.currentRow -= FALL_SPEED * (delta * 10); // Scale drop rate
          if (ball.currentRow <= ball.targetRow) {
            ball.currentRow = ball.targetRow;
            ball.isFalling = false;
          }
        }

        // Pack the current coordinates into our flat Float32Array uniform
        ballPositions[i * 2] = ball.col;
        ballPositions[i * 2 + 1] = ball.currentRow;
      }

      // Handle Canvas Resizing natively within the loop
      if (
        canvas.width !== window.innerWidth ||
        canvas.height !== window.innerHeight
      ) {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        gl.viewport(0, 0, canvas.width, canvas.height);
      }

      // Pass updated states to Twigl and draw
      program.draw({
        resolution: [canvas.width, canvas.height],
        numBalls: balls.length,
        ballPositions: ballPositions,
      });

      requestAnimationFrame(render);
    }

    requestAnimationFrame((t) => {
      lastTime = t;
      requestAnimationFrame(render);
    });
  }
</script>
