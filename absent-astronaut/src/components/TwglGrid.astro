---
// src/components/TwiglGrid.astro
---

<canvas id="twgl-canvas" class="fixed inset-0 -z-10 w-full h-full bg-slate-950"
></canvas>

<script>
  import * as twgl from "twgl.js";

  function init() {
    const canvas = document.getElementById("twgl-canvas") as HTMLCanvasElement;
    const gl = canvas.getContext("webgl2");

    if (!gl) {
      console.error("WebGL2 not supported");
      return;
    }

    const gl2 = gl as WebGL2RenderingContext;
    // 1. Grid Configuration & Constants
    const COLS = 10;
    const ROWS = 5;
    const MAX_BALLS = COLS * ROWS;
    const DROP_INTERVAL = 5000;
    const FALL_SPEED = 0.4;

    const columnHeights = new Array(COLS).fill(0);

    interface Ball {
      col: number;
      targetRow: number;
      currentRow: number;
      isFalling: boolean;
    }

    const balls: Ball[] = [];
    const ballPositions = new Float32Array(MAX_BALLS * 2).fill(-99.0);

    // 2. Define Shaders
    const vs = `#version 300 es
      in vec4 position;
      void main() {
        gl_Position = position;
      }
    `;

    const fs = `#version 300 es
      precision highp float;

      out vec4 fragColor;

      uniform vec2 resolution;
      uniform int numBalls;
      uniform vec2 ballPositions[50];

      float sdCircle(vec2 p, float r) {
        return length(p) - r;
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / resolution.xy;
        float aspect = resolution.x / resolution.y;
        vec2 p = uv;
        p.x *= aspect;

        vec2 gridScale = vec2(10.0, 5.0);
        vec2 normP = p * 12.0 - vec2(1.0, 1.0); 

        vec3 color = vec3(0.05, 0.05, 0.1); 

        for(int c = 0; c < 10; c++) {
          for(int r = 0; r < 5; r++) {
            vec2 slotPos = vec2(float(c) + 0.5, float(r) + 0.5);
            float slotDist = sdCircle(normP - slotPos, 0.4);
            color = mix(color, vec3(0.15, 0.15, 0.25), smoothstep(0.02, 0.0, abs(slotDist) - 0.01));
          }
        }

        for(int i = 0; i < numBalls; i++) {
          vec2 ballPos = ballPositions[i];
          vec2 centerPos = ballPos + vec2(0.5, 0.5);
          
          float d = sdCircle(normP - centerPos, 0.4);
          
          if (d < 0.0) {
            vec3 ballColor = vec3(0.9, 0.2, 0.4);
            color = mix(color, ballColor, smoothstep(0.02, 0.0, d));
          }
        }

        fragColor = vec4(color, 1.0);
      }
    `;

    // 3. Compile Program and Create Fullscreen Quad Buffer via TWGL
    const programInfo = twgl.createProgramInfo(gl2, [vs, fs]);

    // Simple attributes array for a 2D quad covering the screen
    const arrays = {
      position: [-1, -1, 0, 1, -1, 0, -1, 1, 0, -1, 1, 0, 1, -1, 0, 1, 1, 0],
    };
    const bufferInfo = twgl.createBufferInfoFromArrays(gl2, arrays);

    // 4. Drop Logic
    function dropBall() {
      const availableCols = [];
      for (let c = 0; c < COLS; c++) {
        if (columnHeights[c] < ROWS) {
          availableCols.push(c);
        }
      }

      if (availableCols.length === 0) return;

      const randomCol =
        availableCols[Math.floor(Math.random() * availableCols.length)];
      const targetRow = columnHeights[randomCol];

      columnHeights[randomCol]++;

      balls.push({
        col: randomCol,
        targetRow: targetRow,
        currentRow: 5.0,
        isFalling: true,
      });
    }

    dropBall();
    setInterval(dropBall, DROP_INTERVAL);

    let lastTime = 0;

    // 5. Render Loop
    function render(now: number) {
      const delta = (now - lastTime) * 0.001;
      lastTime = now;

      for (let i = 0; i < balls.length; i++) {
        const ball = balls[i];
        if (ball.isFalling) {
          ball.currentRow -= FALL_SPEED * (delta * 10);
          if (ball.currentRow <= ball.targetRow) {
            ball.currentRow = ball.targetRow;
            ball.isFalling = false;
          }
        }

        ballPositions[i * 2] = ball.col;
        ballPositions[i * 2 + 1] = ball.currentRow;
      }

      // TWGL built-in canvas resizing tracker
      twgl.resizeCanvasToDisplaySize(gl2.canvas as HTMLCanvasElement);
      gl2.viewport(0, 0, gl2.canvas.width, gl2.canvas.height);

      gl2.useProgram(programInfo.program);
      twgl.setBuffersAndAttributes(gl2, programInfo, bufferInfo);

      // Pass the uniform block using TWGL setters
      twgl.setUniforms(programInfo, {
        resolution: [gl2.canvas.width, gl2.canvas.height],
        numBalls: balls.length,
        ballPositions: ballPositions,
      });

      twgl.drawBufferInfo(gl2, bufferInfo);

      requestAnimationFrame(render);
    }

    requestAnimationFrame((t) => {
      lastTime = t;
      requestAnimationFrame(render);
    });
  }

  init();
</script>
