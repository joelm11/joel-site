---
import "katex/dist/katex.min.css";
import Base from "./Base.astro";
const { frontmatter, pageTitle, showPageTitle } = Astro.props;
---

<Base pageTitle={pageTitle} showPageTitle={showPageTitle}>
  <meta charset="utf-8" />
  <div class="post-content">
    <slot />
  </div>
</Base>

<style>
  .post-content :global(img) {
    display: block;
    max-width: min(990px, 100%);
    height: auto;
    margin: 1.25rem auto;
  }

  .post-content :global(img.half) {
    max-width: min(495px, 100%);
  }

  .post-content :global(.image-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: flex-start;
    margin: 1.25rem 0;
  }

  .post-content :global(.image-row img) {
    margin: 0;
    max-width: min(240px, 100%);
  }
</style>
