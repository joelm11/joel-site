---
interface Props {
  storageKey?: string;
  passwordHashes?: string[];
}

const { storageKey = "protected-page-unlocked", passwordHashes = [] } =
  Astro.props;
---

<!--
  Client-side gate for static hosting. The protected content is still present
  in the generated HTML, so this is a convenience barrier rather than true
  access control. Use server-side auth or encrypted content if needed.
-->
<div
  class="password-gate"
  data-password-gate
  data-storage-key={storageKey}
  data-password-hashes={JSON.stringify(passwordHashes)}
>
  <form class="password-form">
    <h2>Protected page</h2>
    <p>Enter the password to view this page.</p>
    <label for="password">Password</label>
    <div class="password-row">
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
      <button type="submit">Unlock</button>
    </div>
    <p class="password-error" role="alert" hidden>
      Incorrect password. Please try again.
    </p>
  </form>
</div>

<div class="protected-content" data-protected-content hidden>
  <slot />
</div>

<script>
  const gate = document.querySelector<HTMLElement>("[data-password-gate]");
  const content = document.querySelector<HTMLElement>(
    "[data-protected-content]",
  );

  if (gate && content) {
    const storageKey = gate.dataset.storageKey ?? "protected-page-unlocked";
    const passwordHashes: string[] = JSON.parse(
      gate.dataset.passwordHashes ?? "[]",
    );
    const form = gate.querySelector("form");
    const input = gate.querySelector<HTMLInputElement>(
      "input[type='password']",
    );
    const error = gate.querySelector<HTMLElement>(".password-error");

    const setUnlocked = (unlocked: boolean) => {
      gate.hidden = unlocked;
      content.hidden = !unlocked;
    };

    const isUnlocked = () => {
      try {
        return sessionStorage.getItem(storageKey) === "true";
      } catch {
        return false;
      }
    };

    const rememberUnlocked = () => {
      try {
        sessionStorage.setItem(storageKey, "true");
      } catch {
        // Ignore storage errors (e.g. private browsing).
      }
    };

    const hashPassword = async (password: string) => {
      const data = new TextEncoder().encode(password);
      const digest = await crypto.subtle.digest("SHA-256", data);
      return Array.from(new Uint8Array(digest))
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");
    };

    if (isUnlocked()) {
      setUnlocked(true);
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input) return;

      if (!globalThis.crypto?.subtle) {
        if (error) {
          error.textContent = "This browser cannot unlock this page.";
          error.hidden = false;
        }
        return;
      }

      const password = input.value.trim().toLowerCase();
      const hash = await hashPassword(password);

      if (passwordHashes.includes(hash)) {
        rememberUnlocked();
        setUnlocked(true);
      } else {
        if (error) error.hidden = false;
        input.value = "";
        input.focus();
      }
    });
  }
</script>

<style>
  .password-gate {
    max-width: 32rem;
    margin: 2rem auto;
    padding: 1.5rem;
    border: 1px solid var(--surface-variant);
    border-radius: 14px;
    background: var(--surface);
    color: var(--on-surface);
  }

  .password-gate h2 {
    margin-top: 0;
    color: var(--primary);
  }

  .password-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .password-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .password-row input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--outline);
    border-radius: 6px;
    background: var(--background);
    color: var(--on-background);
    font: inherit;
  }

  .password-row button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--primary);
    border-radius: 6px;
    background: var(--primary);
    color: var(--on-primary);
    font: inherit;
    cursor: pointer;
  }

  .password-row button:hover {
    filter: brightness(1.1);
  }

  .password-error {
    margin: 0;
    color: var(--error);
  }
</style>
